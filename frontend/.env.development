# ==============================================================================
# PiDao Frontend Development Configuration
# ==============================================================================

# --- [1] Local Dev Server ---
VITE_PORT=5173

# --- [2] Backend API ---
# Option A: Use local backend
# VITE_API_URL=http://localhost:5000/api

# Option B: Use Bonto backend
VITE_API_URL=https://pidao.bonto.run/api

# --- [3] Frontend / Pi App URL ---
VITE_PI_APP_URL=http://localhost:5173

# --- [4] Pi Network App Identity ---
VITE_PI_APP_ID=pidao-pi-2uk8
VITE_PI_CLIENT_ID=c_1Hj75SyO_wbM4BUaxgVzuOmplNnrDj_2pWxDUkD8Q

# --- [5] Pi Network Mode ---
VITE_PI_SANDBOX=true

# --- [6] Payment Settings ---
VITE_DEFAULT_PI_AMOUNT=0.01
VITE_MIN_PI_AMOUNT=0.001
VITE_MAX_PI_AMOUNT=100

# ==============================================================================
# Notes:
# 1. This file is for local development only.
# 2. Do not define VITE_API_URL twice.
# 3. After changing env values, restart the Vite dev server.
# ==============================================================================
