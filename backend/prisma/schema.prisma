// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- User & Auth Models ---

enum UserRole {
  USER
  ADMIN
}

model User {
  id              Int           @id @default(autoincrement())
  piUserId        String        @unique
  username        String        @unique
  role            UserRole      @default(USER)
  piWalletAddress String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions    Transaction[]
}

// --- App & Directory Models (The new part) ---

model App {
  id             String   @id @default(uuid())
  category       String   // DeFi, NFT, Games, Tools, Social, Education
  
  // Multi-language support
  title          String
  titleFa        String?
  titleTr        String?
  titleAr        String?
  titleZh        String?

  description    String
  descriptionFa  String?
  descriptionTr  String?
  descriptionAr  String?
  descriptionZh  String?

  image          String?
  tags           String[]
  
  websiteUrl     String?
  demoUrl        String?
  githubUrl      String?

  isVerified     Boolean  @default(false)

  // Boost System fields
  boostPricePi   Float?
  piAppId        String?  @unique
  ownerWallet    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- Commerce & Transaction Models ---

enum TransactionStatus {
  PENDING
  APPROVED
  COMPLETED
  FAILED
  CANCELLED
}

model Product {
  id           String   @id @default(uuid())
  name         String
  description  String
  image        String
  price        Float
  priceDisplay String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Transaction {
  id        Int               @id @default(autoincrement())
  amount    Float
  orderId   String            @unique
  paymentId String?           @unique
  txid      String?           @unique
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  userId    Int
  user      User              @relation(fields: [userId], references: [id])
}
