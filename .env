# ==============================================================================
# PiExplorer Backend Configuration
# ==============================================================================

# --- [1] Runtime Settings ---
NODE_ENV=production
PUBLIC_API_URL=https://piexplorer.bonto.run

# IMPORTANT:
# Do NOT set PORT manually on Bonto.
# Bonto provides process.env.PORT automatically.
# PORT=5000

# --- [2] Security & Authentication ---
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
TOKEN_EXPIRATION=7d

# --- [3] Pi Network ---
PI_API_KEY=REPLACE_WITH_YOUR_REAL_PI_API_KEY
PI_REQUIRE_ACCESS_TOKEN=true

# --- [4] Frontend / CORS ---
FRONTEND_URL=https://apppiexplorerrjk7732.pinet.com
ALLOWED_ORIGINS=https://piexplorerpi.github.io,https://apppiexplorerrjk7732.pinet.com,https://sandbox.minepi.com,https://minepi.com,http://localhost:5173,http://localhost:3000

# --- [5] Database Configuration - Neon PostgreSQL ---
DATABASE_URL=postgresql://YOUR_NEON_DATABASE_URL_HERE?sslmode=require

# ==============================================================================
# Notes:
# - Do NOT commit real JWT_SECRET, PI_API_KEY, or DATABASE_URL to public GitHub.
# - On Bonto, prefer setting these values in Environment Variables / Secrets.
# - Do not manually set PORT on Bonto.
# - FRONTEND_URL should be the public frontend URL.
# - VITE_* variables belong to frontend/.env files, not this backend env.
# ==============================================================================
